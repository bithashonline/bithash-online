[Unit]
Description=BitHash registered-Pod shutdown controller
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=bithash-shutdown
Group=bithash-shutdown
WorkingDirectory=/opt/bithash-shutdown
ExecStart=/usr/bin/node --experimental-sqlite /opt/bithash-shutdown/cli.mjs serve /var/lib/bithash-shutdown/state.sqlite
LoadCredential=runpod-key:/etc/bithash-shutdown/runpod-key
StateDirectory=bithash-shutdown
StateDirectoryMode=0700
UMask=0077
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitCORE=0
MemoryHigh=192M
MemoryMax=256M
CPUWeight=1000
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bithash-shutdown

[Install]
WantedBy=multi-user.target
