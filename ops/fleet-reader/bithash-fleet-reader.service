[Unit]
Description=BitHash read-only registered rental observations
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=bithash-shutdown
Group=bithash-shutdown
ExecStart=/usr/bin/node --experimental-sqlite /opt/bithash-fleet/fleet-reader.mjs
LoadCredential=runpod-key:/etc/bithash-shutdown/runpod-key
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=128M
CPUQuota=20%
[Install]
WantedBy=multi-user.target
